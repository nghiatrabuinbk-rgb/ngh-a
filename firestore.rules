rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny for unspecified collections
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection testing doc
    match /test/connection {
      allow read: if true;
    }

    // Authorized users list
    match /authorized_users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // Students collection - allows read and write for real-time synchronization across devices and shared links
    match /students/{studentId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    // Attendance records (Day Attendance / GVCN)
    match /attendance_records/{recordId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    // Room summaries
    match /room_summaries/{summaryId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    // Night study attendance records (Independent)
    match /night_study_attendance/{recordId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    // Night study room summaries
    match /night_room_summaries/{summaryId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    // School config
    match /school_config/{configId} {
      allow read, write: if true;
    }

    // Room configs
    match /room_configs/{configId} {
      allow read, write: if true;
    }

    // Competition criteria & departments
    match /competition_criteria/{criterionId} {
      allow read, write: if true;
    }

    match /competition_departments/{deptId} {
      allow read, write: if true;
    }

    // Competition room evaluations
    match /competition_evaluations/{evaluationId} {
      allow read, write: if true;
    }

    // Competition deduction rules & room bonuses
    match /competition_deduction_rules/{ruleId} {
      allow read, write: if true;
    }

    match /competition_room_bonuses/{bonusId} {
      allow read, write: if true;
    }
  }
}
